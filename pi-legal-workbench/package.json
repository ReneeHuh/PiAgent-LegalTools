{
  "name": "pi-legal-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "A provenance-first legal research, verification, adversarial review, hearing preparation, and document-production workbench for Pi.",
  "keywords": [
    "pi-package",
    "legal-research",
    "legal-verification",
    "legal-workbench"
  ],
  "type": "module",
  "files": [
    "extensions",
    "skills",
    "prompts",
    "python",
    "assets",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/legal-case-research/index.ts",
      "./extensions/document-authority-verification/index.ts",
      "./extensions/case-summarizer/index.ts",
      "./extensions/case-chat/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test extensions/**/*.test.ts",
    "check": "npm run typecheck && npm test",
    "python:check": "python -m py_compile python/render_docx.py"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "^22.18.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.2"
  }
}
