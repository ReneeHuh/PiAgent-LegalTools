{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pi-legal-workbench/matter.schema.json",
  "title": "Pi Legal Workbench Matter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "matterId",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "matterId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,78}[a-z0-9])?$"
    },
    "status": {
      "enum": ["active"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
